<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Routers are reached over plain HTTP on the LAN (192.168.8.1). -->
    <queries>
        <!-- Fleet theme: VictorLaunch's read-only theme provider (package-visibility on API 30+). -->
        <package android:name="com.victorious.launch" />
        <provider android:authorities="com.victorious.launch.theme" />
    </queries>
    <application
        android:name=".VictorMangoApp"
        android:label="VictorMango"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.VictorMango">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Fleet theme wake-up from VictorLaunch (sent explicitly to this package). Exported; it only
             triggers a re-query, which verifies the provider's package and signing cert. -->
        <receiver
            android:name=".ui.theme.fleet.FleetThemeChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.victorious.launch.action.FLEET_THEME_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
