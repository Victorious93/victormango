<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Routers are reached over plain HTTP on the LAN (192.168.8.1). -->

    <!--
      Read-only router VPN state for VictorLaunch. protectionLevel is signature|knownSigner
      pinned to the VictorLaunch debug cert (see arrays.xml). Add the release cert there
      and in VictorLaunchPins once one is published. The toggle activity itself needs no
      permission because it always shows a confirm dialog.
    -->
    <permission
        android:name="com.victorious.mango.permission.READ_VPN_STATE"
        android:label="@string/perm_read_vpn_state_label"
        android:description="@string/perm_read_vpn_state_desc"
        android:protectionLevel="signature|knownSigner"
        android:knownCerts="@array/victorlaunch_known_certs" />

    <queries>
        <!-- Fleet theme: VictorLaunch's read-only theme provider (package-visibility on API 30+). -->
        <package android:name="com.victorious.launch" />
        <provider android:authorities="com.victorious.launch.theme" />
    </queries>
    <application
        android:name=".VictorMangoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.VictorMango">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name=".VpnToggleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.VictorMango.Dialog">
            <intent-filter>
                <action android:name="com.victorious.mango.action.VPN_ON" />
                <action android:name="com.victorious.mango.action.VPN_OFF" />
                <action android:name="com.victorious.mango.action.VPN_TOGGLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <provider
            android:name=".vpn.VpnStateProvider"
            android:authorities="com.victorious.mango.vpnstate"
            android:exported="true"
            android:grantUriPermissions="false"
            android:readPermission="com.victorious.mango.permission.READ_VPN_STATE"
            android:writePermission="com.victorious.mango.permission.READ_VPN_STATE" />
        <!-- Fleet theme wake-up from VictorLaunch (sent explicitly to this package). Exported; it only
             triggers a re-query, which verifies the provider's package and signing cert. -->
        <receiver
            android:name=".ui.theme.fleet.FleetThemeChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.victorious.launch.action.FLEET_THEME_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
